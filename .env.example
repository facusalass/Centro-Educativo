SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Solo para crear el primer administrador con npm run admin:create.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Clave de respaldo: 32 bytes en base64. Mantener una copia separada del backup.
BACKUP_KEY=""
